{
  "name": "pharaonic/laravel-likes",
  "description": "Polymorphic likes for Laravel Eloquent models, with database-enforced uniqueness and explicit changed-state results.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "likes",
    "like",
    "eloquent",
    "polymorphic",
    "pharaonic"
  ],
  "authors": [
    {
      "name": "Moamen Eltouny (Raggi)",
      "email": "raggigroup@gmail.com"
    }
  ],
  "support": {
    "docs": "https://pharaonic.dev/packages/laravel/likes",
    "issues": "https://github.com/Pharaonic/laravel-likes/issues",
    "source": "https://github.com/Pharaonic/laravel-likes"
  },
  "require": {
    "php": ">=8.0 <8.2",
    "illuminate/contracts": "^8.75",
    "illuminate/database": "^8.75",
    "illuminate/support": "^8.75"
  },
  "require-dev": {
    "laravel/pint": "^1.5",
    "orchestra/testbench": "^6.25",
    "pestphp/pest": "^1.23",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6.33"
  },
  "autoload": {
    "psr-4": {
      "Pharaonic\\Laravel\\Likes\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pharaonic\\Laravel\\Likes\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pharaonic\\Laravel\\Likes\\LikesServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/pest",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test",
    "security": "@composer audit",
    "check": [
      "@composer validate --strict",
      "@format:check",
      "@analyse",
      "@test",
      "@security"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "audit": {
      "abandoned": "report"
    },
    "policy": {
      "advisories": {
        "block": false,
        "ignore": {
          "laravel/framework": "No fixed release within Laravel 8; the application chooses the framework release.",
          "league/flysystem": "No fixed release within Laravel 8; the application chooses the framework release."
        }
      }
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
