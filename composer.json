{
  "name": "pharaonic/laravel-likes",
  "description": "Polymorphic likes for Laravel Eloquent models, with database-enforced uniqueness and explicit changed-state results.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "likes",
    "like",
    "eloquent",
    "polymorphic",
    "pharaonic"
  ],
  "authors": [
    {
      "name": "Moamen Eltouny (Raggi)",
      "email": "raggigroup@gmail.com"
    }
  ],
  "support": {
    "docs": "https://pharaonic.dev/packages/laravel/likes",
    "issues": "https://github.com/Pharaonic/laravel-likes/issues",
    "source": "https://github.com/Pharaonic/laravel-likes"
  },
  "require": {
    "php": ">=8.3 <8.6",
    "illuminate/contracts": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.0",
    "phpstan/phpstan": "^2.1.33",
    "phpunit/phpunit": "^12.5.8"
  },
  "autoload": {
    "psr-4": {
      "Pharaonic\\Laravel\\Likes\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pharaonic\\Laravel\\Likes\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pharaonic\\Laravel\\Likes\\LikesServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/pest",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test",
    "security": "@composer audit",
    "check": [
      "@composer validate --strict",
      "@format:check",
      "@analyse",
      "@test",
      "@security"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "audit": {
      "abandoned": "report"
    },
    "policy": {
      "advisories": {
        "block": false
      }
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
